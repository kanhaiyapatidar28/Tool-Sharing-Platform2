# ToolShare India - Environment Configuration Example

# MongoDB Connection String (e.g., MongoDB Atlas or local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/toolshare?retryWrites=true&w=majority

# Cryptographic Session & Token Signing Secret (Minimum 32 random characters)
AUTH_SECRET=your_cryptographically_secure_random_auth_secret_key_here_32_chars

# Public Application URL (used for generating real-world camera-scannable QR links)
# Production: https://tool-sharing-platform.vercel.app
# Local Development: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Node Environment
NODE_ENV=development
